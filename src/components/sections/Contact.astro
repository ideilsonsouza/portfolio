---
import { ArrowUpRight, Mail, MessageCircle } from "lucide-astro";

const whatsappUrl =
  "https://wa.me/5564992462048?text=Ol%C3%A1%20Ideilson%2C%20vim%20pelo%20seu%20portf%C3%B3lio%20e%20gostaria%20de%20conversar!";
---

<section
  id="contact"
  class="mx-auto max-w-7xl px-6 py-24 md:px-12"
  aria-labelledby="contact-title"
>
  <div
    data-reveal
    class="relative overflow-hidden rounded-[2rem] border border-[var(--lava)]/25 bg-[#0e1724] p-8 shadow-2xl sm:p-12 lg:p-16"
  >
    <!-- Background subtle glow Pickfast style -->
    <div
      aria-hidden="true"
      class="absolute -bottom-24 -right-24 -z-10 h-80 w-80 rounded-full bg-[var(--lava)]/10 blur-[100px]"
    >
    </div>
    <div
      aria-hidden="true"
      class="absolute -top-24 -left-24 -z-10 h-80 w-80 rounded-full bg-[var(--coastal)]/10 blur-[100px]"
    >
    </div>

    <p class="eyebrow text-[var(--lava)]">Contato direto</p>
    <div class="mt-5 grid gap-10 lg:grid-cols-[1.2fr_.8fr] lg:items-end">
      <div>
        <h2
          id="contact-title"
          class="max-w-2xl text-4xl font-semibold tracking-[-.055em] text-white sm:text-5xl"
        >
          Seu sistema está pedindo uma arquitetura melhor?
        </h2>
        <p class="mt-6 max-w-xl text-lg leading-8 text-[var(--muted)]">
          Vamos conversar sobre integrações, dados, produto ou uma operação que precisa ganhar escala e estabilidade.
        </p>
      </div>

      <div class="flex flex-col gap-3.5">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noreferrer"
          class="group inline-flex min-h-12 items-center justify-between rounded-full bg-[#198754] px-6 font-semibold text-white shadow-[0_4px_16px_rgba(25,135,84,0.35)] transition-all duration-200 hover:bg-[#157347] hover:shadow-[0_6px_22px_rgba(25,135,84,0.5)] hover:scale-[1.01]"
        >
          <span>Falar no WhatsApp</span>
          <MessageCircle
            class="w-5 h-5 transition-transform duration-200 group-hover:scale-110"
            aria-hidden="true"
          />
        </a>
        <a
          href="mailto:contato@icbox.com.br"
          class="group inline-flex min-h-12 items-center justify-between rounded-full border border-[var(--coastal)]/30 bg-white/[0.02] px-6 font-semibold text-white transition-all duration-200 hover:border-[var(--coastal)] hover:bg-[var(--coastal)]/10 hover:scale-[1.01]"
        >
          <span>Enviar e-mail</span>
          <Mail
            class="w-5 h-5 text-[var(--coastal)] transition-colors duration-200 group-hover:text-white"
            aria-hidden="true"
          />
        </a>
        <a
          href="https://www.linkedin.com/in/ideilson/"
          target="_blank"
          rel="noreferrer"
          class="group inline-flex min-h-12 items-center justify-between rounded-full border border-white/15 bg-white/[0.02] px-6 font-semibold text-white transition-all duration-200 hover:border-white/40 hover:bg-white/5 hover:scale-[1.01]"
        >
          <span>Conectar no LinkedIn</span>
          <ArrowUpRight
            class="w-5 h-5 text-[var(--muted)] transition-all duration-200 group-hover:text-white group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            aria-hidden="true"
          />
        </a>
      </div>
    </div>
  </div>
</section>
