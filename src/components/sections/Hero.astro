---
import { Image } from "astro:assets";
import { ArrowDownRight, ArrowUpRight, Cpu, ShieldCheck } from "lucide-astro";
import profileImg from "../../../public/profile.jpeg";

const whatsappUrl =
  "https://wa.me/5564992462048?text=Ol%C3%A1%20Ideilson%2C%20vim%20pelo%20seu%20portf%C3%B3lio%20e%20gostaria%20de%20conversar!";
---

<section id="about" class="relative isolate overflow-hidden pt-32 sm:pt-40">
  <div aria-hidden="true" class="site-grid absolute inset-0 -z-10"></div>
  <div
    aria-hidden="true"
    class="absolute -right-40 top-12 -z-10 h-96 w-96 rounded-full bg-emerald-300/10 blur-[110px]"
  >
  </div>

  <div
    class="mx-auto grid max-w-7xl gap-14 px-6 pb-20 md:px-12 lg:grid-cols-[1.15fr_.85fr] lg:items-end lg:pb-28"
  >
    <div data-reveal>
      <div class="mb-7 inline-flex items-center gap-3 rounded-full border border-emerald-300/20 bg-emerald-300/5 px-4 py-1.5">
        <span class="status-pulse">
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-300"></span>
        </span>
        <span class="font-mono text-xs font-bold uppercase tracking-[.14em] text-emerald-300">
          Engenharia de software · Brasil
        </span>
      </div>

      <h1
        data-reveal
        data-reveal-delay="100"
        class="max-w-4xl text-5xl font-semibold tracking-[-.06em] text-white sm:text-6xl lg:text-7xl"
      >
        Sistemas que <span class="text-emerald-300 drop-shadow-[0_0_20px_rgba(120,167,255,0.35)]">aguentam</span> quando o negócio acelera.
      </h1>

      <p
        data-reveal
        data-reveal-delay="200"
        class="mt-8 max-w-2xl text-lg leading-8 text-[var(--muted)] sm:text-xl"
      >
        Ideilson é engenheiro de software focado em dados, integrações e arquitetura de produtos que precisam ser rápidos, observáveis e confiáveis.
      </p>

      <div
        data-reveal
        data-reveal-delay="300"
        class="mt-10 flex flex-col gap-3 sm:flex-row"
      >
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noreferrer"
          class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-emerald-300 px-6 font-semibold text-slate-950 transition hover:bg-emerald-200 hover:shadow-[0_0_20px_rgba(120,167,255,0.4)]"
        >
          Iniciar uma conversa
          <ArrowUpRight class="w-4 h-4" aria-hidden="true" />
        </a>
        <a
          href="#work"
          class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full border border-white/15 px-6 font-semibold text-white transition hover:border-emerald-300/60 hover:bg-white/5 hover:shadow-[0_0_15px_rgba(120,167,255,0.15)]"
        >
          Ver áreas de atuação
          <ArrowDownRight class="w-4 h-4" aria-hidden="true" />
        </a>
      </div>
    </div>

    <div
      data-reveal
      data-reveal-delay="150"
      class="relative mx-auto w-full max-w-md pb-20 lg:mx-0 lg:justify-self-end"
    >
      <div
        data-parallax
        data-parallax-speed="-0.04"
        class="overflow-hidden rounded-[2rem] border border-white/10 bg-[var(--surface)] p-3 shadow-2xl shadow-black/40 transition-transform duration-300"
      >
        <div class="relative aspect-[4/5] overflow-hidden rounded-[1.45rem]">
          <Image
            src={profileImg}
            alt="Ideilson, engenheiro de software"
            widths={[320, 420, 640]}
            sizes="(max-width: 768px) 100vw, 420px"
            class="object-cover w-full h-full"
            loading="eager"
            fetchpriority="high"
          />
          <div
            class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[#07111f] via-[#07111f]/80 to-transparent p-6 pt-24"
          >
            <p class="font-mono text-xs uppercase tracking-[.12em] text-emerald-300 flex items-center gap-2">
              <Cpu class="w-3.5 h-3.5" />
              Perfil técnico
            </p>
            <p class="mt-2 text-lg font-semibold text-white">
              Back-end, dados e produtos conectados.
            </p>
          </div>
        </div>
      </div>

      <div
        data-parallax
        data-parallax-speed="0.08"
        class="absolute bottom-0 -left-4 max-w-[17.5rem] rounded-2xl border border-emerald-200/20 bg-[#0b1a2a]/95 p-4 shadow-2xl backdrop-blur sm:-left-10"
      >
        <p class="font-mono text-[.65rem] font-bold uppercase tracking-[.1em] text-emerald-300 flex items-center gap-1.5">
          <ShieldCheck class="w-3.5 h-3.5" />
          Modo de trabalho
        </p>
        <p class="mt-2 text-sm leading-5 text-slate-200">
          Do problema operacional à arquitetura que dá escala e previsibilidade.
        </p>
      </div>
    </div>
  </div>
</section>
