---
const items = [
  "Sistemas Distribuídos",
  "Alta Disponibilidade",
  "Rust & Zero-Cost Abstractions",
  "Go & Concorrência",
  "Engenharia de Dados",
  "APIs Críticas & SLAs",
  "Observabilidade & Telemetria",
  "Design de Produtos B2B",
  "Integrações Resilientes",
];
---

<div class="ribbon-container my-14" aria-hidden="true">
  <div class="ribbon-track">
    <!-- Bloco 1 -->
    {
      items.map((item, index) => (
        <div class="ribbon-item">
          <span class="hover:text-[var(--lava)] transition-colors">{item}</span>
          <span class={`ribbon-dot ${index % 2 === 0 ? "bg-[var(--lava)] shadow-[0_0_10px_var(--lava)]" : "bg-[var(--coastal)] shadow-[0_0_10px_var(--coastal)]"}`} />
        </div>
      ))
    }
    <!-- Bloco 2 (duplicado para loop infinito fluido) -->
    {
      items.map((item, index) => (
        <div class="ribbon-item">
          <span class="hover:text-[var(--lava)] transition-colors">{item}</span>
          <span class={`ribbon-dot ${index % 2 === 0 ? "bg-[var(--lava)] shadow-[0_0_10px_var(--lava)]" : "bg-[var(--coastal)] shadow-[0_0_10px_var(--coastal)]"}`} />
        </div>
      ))
    }
  </div>
</div>
