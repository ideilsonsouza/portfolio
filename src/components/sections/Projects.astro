---
import {
  ArrowUpRight,
  Bot,
  Database,
  Factory,
  FileCheck2,
  GitFork,
  MessageSquareMore,
  MonitorCog,
} from "lucide-astro";

const products = [
  {
    title: "Nexus Bridge",
    subtitle: "Integrações sem substituir tudo",
    description:
      "Conecte o sistema legado a qualquer destino. Receba dados, valide em sandbox, transforme e envie com rastreabilidade.",
    tech: "n8n · Airflow · APIs · sandbox",
    icon: GitFork,
    slug: "nexus-bridge",
    accent: "coastal",
    badgeColor: "border-[var(--coastal)]/30 bg-[var(--coastal)]/10 text-[var(--coastal)]",
    hoverBorder: "group-hover:border-[var(--coastal)]/50",
    pillColor: "text-[var(--coastal)]",
  },
  {
    title: "Fiscal Connect",
    subtitle: "Documentos fiscais no seu fluxo",
    description:
      "Automatize a captura e a entrega de dados fiscais para ERP, financeiro, estoque ou uma API própria — com segurança desde a origem.",
    tech: "NF-e · webhooks · ERP · validação",
    icon: FileCheck2,
    slug: "fiscal-connect",
    accent: "lava",
    badgeColor: "border-[var(--lava)]/30 bg-[var(--lava)]/10 text-[var(--lava)]",
    hoverBorder: "group-hover:border-[var(--lava)]/50",
    pillColor: "text-[var(--lava)]",
  },
  {
    title: "Context AI",
    subtitle: "IA aplicada ao trabalho real",
    description:
      "Crie assistentes que entendem o contexto da empresa e ajudam times a atender, analisar, decidir e executar com supervisão humana.",
    tech: "RAG · agentes · auditoria · aprovação",
    icon: Bot,
    slug: "ia-de-negocio",
    accent: "amber",
    badgeColor: "border-[var(--amber)]/30 bg-[var(--amber)]/10 text-[var(--amber)]",
    hoverBorder: "group-hover:border-[var(--amber)]/50",
    pillColor: "text-[var(--amber)]",
  },
];

const applications = [
  {
    title: "Pulse Ops",
    description:
      "Painel de operações que conecta receita, pedidos, integrações e exceções em uma leitura acionável.",
    icon: Database,
    slug: "operacoes-dados",
    iconColor: "text-[var(--coastal)]",
    badgeBg: "border-[var(--coastal)]/25 bg-[var(--coastal)]/10",
  },
  {
    title: "Fluxo Inbox",
    description:
      "Central de conversas que une WhatsApp, automação e atendimento humano com contexto preservado.",
    icon: MessageSquareMore,
    slug: "automacao-conversacional",
    iconColor: "text-[var(--lava)]",
    badgeBg: "border-[var(--lava)]/25 bg-[var(--lava)]/10",
  },
  {
    title: "Linha Sinal",
    description:
      "Monitoramento industrial para tornar eventos do chão de fábrica visíveis e fáceis de priorizar.",
    icon: Factory,
    slug: "telemetria-industrial",
    iconColor: "text-[var(--amber)]",
    badgeBg: "border-[var(--amber)]/25 bg-[var(--amber)]/10",
  },
  {
    title: "Station Control",
    description:
      "Aplicação desktop para operações locais que exigem estabilidade, velocidade e sincronização controlada.",
    icon: MonitorCog,
    slug: "desktop-critico",
    iconColor: "text-[#198754]",
    badgeBg: "border-[#198754]/30 bg-[#198754]/10",
  },
];
---

<section
  id="work"
  class="section-rule mx-auto max-w-7xl px-6 py-24 md:px-12"
  aria-labelledby="work-title"
>
  <div class="grid gap-7 lg:grid-cols-[1fr_.7fr]" data-reveal>
    <div>
      <p class="eyebrow">Produtos modulares</p>
      <h2
        id="work-title"
        class="mt-4 max-w-2xl text-3xl font-semibold tracking-[-.045em] text-white sm:text-4xl"
      >
        SaaS que se adapta ao seu negócio — não o contrário.
      </h2>
    </div>
    <p class="self-end leading-7 text-[var(--muted)]">
      Partimos de blocos que já resolvem problemas críticos e customizamos a experiência, os conectores e as regras para o nicho, os sistemas e a operação de cada cliente.
    </p>
  </div>

  <div
    class="mt-12 grid gap-px overflow-hidden rounded-3xl border border-white/10 bg-white/10 md:grid-cols-3"
  >
    {
      products.map(
        ({ title, subtitle, description, tech, icon: Icon, slug, badgeColor, pillColor }, index) => (
          <article
            data-reveal
            data-reveal-delay={(index + 1) * 100}
            class="group flex min-h-96 flex-col bg-[#080d16] p-8 transition-all duration-300 hover:bg-[#0e1724] hover:shadow-2xl"
          >
            <div class="flex items-center justify-between">
              <div class={`grid h-12 w-12 place-items-center rounded-xl border ${badgeColor} transition-transform duration-300 group-hover:scale-110`}>
                <Icon class="w-6 h-6" aria-hidden="true" />
              </div>
              <span class="font-mono text-xs text-[var(--faint)]">
                0{index + 1}
              </span>
            </div>

            <p class={`mt-8 font-mono text-[.68rem] font-bold uppercase tracking-[.12em] ${pillColor}`}>
              {subtitle}
            </p>
            <h3 class="mt-3 text-2xl font-semibold tracking-[-.035em] text-white transition-colors duration-200 group-hover:text-white">
              {title}
            </h3>
            <p class="mt-4 leading-7 text-[var(--muted)]">{description}</p>
            <div class="mt-auto pt-8">
              <p class="font-mono text-xs font-semibold uppercase tracking-[.08em] text-[var(--muted)]">
                {tech}
              </p>
              <a
                href={`/demos/${slug}`}
                class={`mt-5 inline-flex items-center gap-2 text-sm font-semibold transition hover:underline group-hover:translate-x-1 ${pillColor}`}
              >
                Ver como funciona
                <ArrowUpRight
                  class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                  aria-hidden="true"
                />
              </a>
            </div>
          </article>
        )
      )
    }
  </div>

  <div class="mt-20 border-t border-white/10 pt-10" data-reveal>
    <p class="eyebrow">Outras aplicações possíveis</p>
    <div
      class="mt-5 flex flex-col justify-between gap-5 sm:flex-row sm:items-end"
    >
      <h3
        class="max-w-xl text-2xl font-semibold tracking-[-.035em] text-white sm:text-3xl"
      >
        Também construímos aplicações sob medida para a operação.
      </h3>
      <p class="max-w-sm text-sm leading-6 text-[var(--muted)]">
        As soluções abaixo continuam disponíveis como demonstrações independentes.
      </p>
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {
        applications.map(({ title, description, icon: Icon, slug, iconColor, badgeBg }, index) => (
          <a
            href={`/demos/${slug}`}
            data-reveal
            data-reveal-delay={(index + 1) * 80}
            class="interactive-card group rounded-2xl border border-white/10 bg-[#0e1724]/70 p-6 backdrop-blur transition hover:bg-[#132032]"
          >
            <div class="flex items-start justify-between gap-4">
              <div class={`grid h-11 w-11 place-items-center rounded-xl border ${badgeBg} ${iconColor} transition-transform duration-200 group-hover:scale-105`}>
                <Icon class="w-5 h-5" aria-hidden="true" />
              </div>
              <ArrowUpRight
                class="w-4 h-4 text-[var(--faint)] transition-all duration-200 group-hover:text-white group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                aria-hidden="true"
              />
            </div>
            <h4 class="mt-6 text-lg font-semibold text-white transition-colors">
              {title}
            </h4>
            <p class="mt-2 text-sm leading-6 text-[var(--muted)]">
              {description}
            </p>
          </a>
        ))
      }
    </div>
  </div>

  <p class="mt-6 text-sm leading-6 text-[var(--faint)]" data-reveal>
    Demonstrações com dados fictícios. A solução final é desenhada para o processo, os dados e os requisitos de segurança do cliente.
  </p>
</section>
