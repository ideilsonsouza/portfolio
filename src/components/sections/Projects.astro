---
import {
  ArrowUpRight,
  Bot,
  CheckCircle2,
  Database,
  Factory,
  FileCheck2,
  GitFork,
  MessageSquareMore,
  MonitorCog,
} from "lucide-astro";

const products = [
  {
    title: "Nexus Bridge",
    subtitle: "Integrações sem substituir tudo",
    description:
      "Conecte o sistema legado a qualquer destino. Receba dados, valide em sandbox, transforme e envie com rastreabilidade.",
    tech: "n8n · Airflow · APIs · sandbox",
    icon: GitFork,
    slug: "nexus-bridge",
    badgeColor: "border-[#179bd7]/30 bg-[#e9f6fc] text-[#0f7db0]",
    pillColor: "text-[#0f7db0]",
    borderColor: "hover:border-[#179bd7]",
  },
  {
    title: "Fiscal Connect",
    subtitle: "Documentos fiscais no seu fluxo",
    description:
      "Automatize a captura e a entrega de dados fiscais para ERP, financeiro, estoque ou uma API própria — com segurança desde a origem.",
    tech: "NF-e · webhooks · ERP · validação",
    icon: FileCheck2,
    slug: "fiscal-connect",
    badgeColor: "border-[#ff6c2c]/30 bg-[#fff4ed] text-[#e8591a]",
    pillColor: "text-[#e8591a]",
    borderColor: "hover:border-[#ff6c2c]",
  },
  {
    title: "Context AI",
    subtitle: "IA aplicada ao trabalho real",
    description:
      "Crie assistentes que entendem o contexto da empresa e ajudam times a atender, analisar, decidir e executar com supervisão humana.",
    tech: "RAG · agentes · auditoria · aprovação",
    icon: Bot,
    slug: "ia-de-negocio",
    badgeColor: "border-[#f59e0b]/30 bg-[#fffbeb] text-[#d97706]",
    pillColor: "text-[#d97706]",
    borderColor: "hover:border-[#f59e0b]",
  },
];

const applications = [
  {
    title: "Pulse Ops",
    description:
      "Painel de operações que conecta receita, pedidos, integrações e exceções em uma leitura acionável.",
    icon: Database,
    slug: "operacoes-dados",
    iconColor: "text-[#0f7db0]",
    badgeBg: "border-[#179bd7]/30 bg-[#e9f6fc]",
  },
  {
    title: "Fluxo Inbox",
    description:
      "Central de conversas que une WhatsApp, automação e atendimento humano com contexto preservado.",
    icon: MessageSquareMore,
    slug: "automacao-conversacional",
    iconColor: "text-[#e8591a]",
    badgeBg: "border-[#ff6c2c]/30 bg-[#fff4ed]",
  },
  {
    title: "Linha Sinal",
    description:
      "Monitoramento industrial para tornar eventos do chão de fábrica visíveis e fáceis de priorizar.",
    icon: Factory,
    slug: "telemetria-industrial",
    iconColor: "text-[#d97706]",
    badgeBg: "border-[#f59e0b]/30 bg-[#fffbeb]",
  },
  {
    title: "Station Control",
    description:
      "Aplicação desktop para operações locais que exigem estabilidade, velocidade e sincronização controlada.",
    icon: MonitorCog,
    slug: "desktop-critico",
    iconColor: "text-[#198754]",
    badgeBg: "border-[#198754]/30 bg-[#ebf5ef]",
  },
];
---

<section
  id="work"
  class="bg-[var(--canvas)] py-28 md:py-36 relative"
  aria-labelledby="work-title"
>
  <div class="mx-auto max-w-7xl px-6 md:px-12">
    <div class="grid gap-7 lg:grid-cols-[1fr_.7fr]" data-reveal>
    <div>
      <p class="eyebrow">Produtos modulares</p>
      <h2
        id="work-title"
        class="mt-4 max-w-2xl text-3xl font-semibold tracking-[-.045em] text-[#142638] sm:text-4xl"
      >
        SaaS que se adapta ao seu negócio — não o contrário.
      </h2>
    </div>
    <p class="self-end leading-7 text-[#607486]">
      Partimos de blocos que já resolvem problemas críticos e customizamos a experiência, os conectores e as regras para o nicho, os sistemas e a operação de cada cliente.
    </p>
  </div>

  <div
    class="mt-12 grid gap-6 md:grid-cols-3"
  >
    {
      products.map(
        ({ title, subtitle, description, tech, icon: Icon, slug, badgeColor, pillColor, borderColor }, index) => (
          <article
            data-reveal
            data-reveal-delay={(index + 1) * 100}
            class={`interactive-card group flex min-h-96 flex-col rounded-3xl p-8 transition-all duration-300 ${borderColor}`}
          >
            <div class="flex items-center justify-between">
              <div class={`grid h-12 w-12 place-items-center rounded-xl border ${badgeColor} transition-transform duration-300 group-hover:scale-110 shadow-sm`}>
                <Icon class="w-6 h-6" aria-hidden="true" />
              </div>
              <span class="font-mono text-xs font-semibold text-[#8a9aaa]">
                0{index + 1}
              </span>
            </div>

            <p class={`mt-8 font-mono text-[.68rem] font-bold uppercase tracking-[.12em] ${pillColor}`}>
              {subtitle}
            </p>
            <h3 class="mt-3 text-2xl font-semibold tracking-[-.035em] text-[#142638] transition-colors duration-200">
              {title}
            </h3>
            <p class="mt-4 leading-7 text-[#607486]">{description}</p>
            <div class="mt-auto pt-8">
              <p class="font-mono text-xs font-semibold uppercase tracking-[.08em] text-[#8a9aaa]">
                {tech}
              </p>
              <a
                href={`/demos/${slug}`}
                class={`mt-5 inline-flex items-center gap-2 text-sm font-semibold transition hover:underline group-hover:translate-x-1 ${pillColor}`}
              >
                Ver demonstração & módulos
                <ArrowUpRight
                  class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                  aria-hidden="true"
                />
              </a>
            </div>
          </article>
        )
      )
    }
  </div>

  <div class="mt-20 border-t border-[#d7e1ea] pt-10" data-reveal>
    <p class="eyebrow">Outras aplicações possíveis</p>
    <div
      class="mt-5 flex flex-col justify-between gap-5 sm:flex-row sm:items-end"
    >
      <h3
        class="max-w-xl text-2xl font-semibold tracking-[-.035em] text-[#142638] sm:text-3xl"
      >
        Também construímos aplicações sob medida para a operação.
      </h3>
      <p class="max-w-sm text-sm leading-6 text-[#607486]">
        As soluções abaixo continuam disponíveis como demonstrações independentes.
      </p>
    </div>

    <div class="mt-8 grid gap-5 md:grid-cols-2">
      {
        applications.map(({ title, description, icon: Icon, slug, iconColor, badgeBg }, index) => (
          <a
            href={`/demos/${slug}`}
            data-reveal
            data-reveal-delay={(index + 1) * 80}
            class="interactive-card group rounded-2xl p-6 transition"
          >
            <div class="flex items-start justify-between gap-4">
              <div class={`grid h-11 w-11 place-items-center rounded-xl border ${badgeBg} ${iconColor} transition-transform duration-200 group-hover:scale-105 shadow-sm`}>
                <Icon class="w-5 h-5" aria-hidden="true" />
              </div>
              <ArrowUpRight
                class="w-4 h-4 text-[#8a9aaa] transition-all duration-200 group-hover:text-[var(--lava)] group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                aria-hidden="true"
              />
            </div>
            <h4 class="mt-6 text-lg font-semibold text-[#142638] transition-colors group-hover:text-[var(--lava)]">
              {title}
            </h4>
            <p class="mt-2 text-sm leading-6 text-[#607486]">
              {description}
            </p>
          </a>
        ))
      }
    </div>
  </div>

  <div class="mt-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 rounded-2xl border border-[#d7e1ea] bg-white p-5 shadow-sm" data-reveal>
    <div class="flex items-center gap-3">
      <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl border border-[#198754]/30 bg-[#ebf5ef] text-[#198754]">
        <CheckCircle2 class="w-5 h-5" />
      </span>
      <p class="text-sm text-[#293a4a] leading-6">
        <strong class="text-[#142638]">Módulos prontos para implantação:</strong> Cada aplicação demonstrada possui arquitetura, schemas tipados e regras de integração que podem ser adaptados e implantados na sua infraestrutura sob demanda.
      </p>
    </div>
    <a
      href="#contact"
      class="btn-lava inline-flex shrink-0 items-center gap-1.5 rounded-full px-5 py-2.5 text-xs font-semibold text-white shadow-sm"
    >
      Solicitar especificação técnica
    </a>
  </div>
  </div>
</section>
