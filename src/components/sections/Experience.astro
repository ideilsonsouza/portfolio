---
const experiences = [
  {
    period: "2023 — hoje",
    role: "Senior Software Engineer",
    company: "ICBOX",
    description:
      "Liderança técnica para microserviços e sistemas distribuídos, unindo Rust, Go, Node.js e C# a práticas de observabilidade e performance.",
    tech: ["Rust", "Go", "Node.js", "PostgreSQL", "Docker", "Sagas"],
  },
  {
    period: "2020 — 2023",
    role: "Full-stack Developer",
    company: "Consultoria independente",
    description:
      "Produtos SaaS multi-tenant, integrações de pagamentos e painéis analíticos para operações que dependem de dados confiáveis.",
    tech: ["React", "FastAPI", "NestJS", "PIX", "Webhooks"],
  },
];
---

<section
  id="experience"
  class="section-rule mx-auto max-w-7xl px-6 py-24 md:px-12"
  aria-labelledby="experience-title"
>
  <div class="grid gap-10 lg:grid-cols-[.72fr_1.28fr]">
    <div data-reveal>
      <p class="eyebrow">Trajetória</p>
      <h2
        id="experience-title"
        class="mt-4 text-3xl font-semibold tracking-[-.045em] text-white sm:text-4xl"
      >
        Experiência para decisões que não podem falhar.
      </h2>
    </div>

    <ol class="divide-y divide-white/10 border-t border-white/10">
      {
        experiences.map((item, index) => (
          <li
            data-reveal
            data-reveal-delay={(index + 1) * 120}
            class="group grid gap-4 py-8 sm:grid-cols-[9rem_1fr] transition-colors hover:bg-white/[0.015] px-4 -mx-4 rounded-xl"
          >
            <p class="font-mono text-xs font-semibold uppercase tracking-[.08em] text-[var(--faint)] pt-1">
              {item.period}
            </p>
            <div>
              <h3 class="text-xl font-semibold text-white transition-colors group-hover:text-emerald-200">
                {item.role}{" "}
                <span class="text-emerald-300">/ {item.company}</span>
              </h3>
              <p class="mt-3 leading-7 text-[var(--muted)]">{item.description}</p>
              <ul class="mt-5 flex flex-wrap gap-2">
                {item.tech.map((tech) => (
                  <li class="rounded-md border border-white/10 bg-white/5 px-2.5 py-1 font-mono text-xs text-slate-300 transition-colors group-hover:border-emerald-300/30 group-hover:text-emerald-200">
                    {tech}
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
