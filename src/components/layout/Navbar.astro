---
import { Menu, X } from "lucide-astro";

const links = [
  { name: "Sobre", href: "#about" },
  { name: "Experiência", href: "#experience" },
  { name: "Especialidades", href: "#work" },
  { name: "Contato", href: "#contact" },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-[#d7e1ea] bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 md:px-12">
    <a href="#about" class="flex items-center gap-3 font-semibold text-[#142638] group">
      <span class="grid h-8 w-8 place-items-center rounded-lg border border-[var(--coastal)]/40 bg-[var(--coastal)]/10 font-mono text-xs font-bold text-[var(--coastal)] transition-colors group-hover:border-[var(--lava)] group-hover:text-[var(--lava)]">
        ID
      </span>
      <span class="tracking-tight text-lg">Ideilson</span>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Navegação principal">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-[#607486] transition-colors hover:text-[#142638]"
          >
            {link.name}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-4 md:flex">
      <span class="hidden lg:inline-flex items-center gap-2 rounded-full border border-[#198754]/25 bg-[#ebf5ef] px-3 py-1 font-mono text-xs font-semibold text-[#198754]">
        <span class="status-pulse-basil">
          <span class="relative inline-flex h-2 w-2 rounded-full bg-[#198754]"></span>
        </span>
        Disponível
      </span>

      <a
        href="#contact"
        class="btn-lava rounded-full px-5 py-2 text-sm font-semibold transition"
      >
        Vamos conversar
      </a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="grid h-10 w-10 place-items-center rounded-lg border border-[#d7e1ea] text-[#142638] md:hidden hover:border-[var(--lava)]"
    >
      <span id="menu-icon-open" class="block">
        <Menu class="w-5 h-5" aria-hidden="true" />
      </span>
      <span id="menu-icon-close" class="hidden">
        <X class="w-5 h-5" aria-hidden="true" />
      </span>
    </button>
  </div>

  <nav
    id="mobile-menu"
    class="hidden border-t border-[#d7e1ea] bg-white px-6 pb-6 pt-3 md:hidden shadow-lg"
    aria-label="Navegação móvel"
  >
    {
      links.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link block py-3 text-base text-[#293a4a] hover:text-[var(--lava)] font-medium transition"
        >
          {link.name}
        </a>
      ))
    }
    <div class="mt-4 pt-4 border-t border-[#d7e1ea] flex items-center justify-between">
      <span class="inline-flex items-center gap-2 font-mono text-xs font-semibold text-[#198754]">
        <span class="status-pulse-basil">
          <span class="relative inline-flex h-2 w-2 rounded-full bg-[#198754]"></span>
        </span>
        Disponível para novos projetos
      </span>
      <a
        href="#contact"
        class="btn-lava rounded-full px-4 py-2 text-xs font-semibold"
      >
        Contato
      </a>
    </div>
  </nav>
</header>

<script>
  const toggleBtn = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("menu-icon-open");
  const iconClose = document.getElementById("menu-icon-close");
  const mobileLinks = document.querySelectorAll(".mobile-nav-link");

  function setMenu(isOpen: boolean) {
    if (!toggleBtn || !mobileMenu || !iconOpen || !iconClose) return;
    toggleBtn.setAttribute("aria-expanded", String(isOpen));
    toggleBtn.setAttribute("aria-label", isOpen ? "Fechar menu" : "Abrir menu");
    if (isOpen) {
      mobileMenu.classList.remove("hidden");
      iconOpen.classList.add("hidden");
      iconClose.classList.remove("hidden");
    } else {
      mobileMenu.classList.add("hidden");
      iconOpen.classList.remove("hidden");
      iconClose.classList.add("hidden");
    }
  }

  toggleBtn?.addEventListener("click", () => {
    const isCurrentlyOpen = toggleBtn.getAttribute("aria-expanded") === "true";
    setMenu(!isCurrentlyOpen);
  });

  mobileLinks.forEach((link) => {
    link.addEventListener("click", () => {
      setMenu(false);
    });
  });
</script>
