---
import RootLayout from "../layouts/RootLayout.astro";
import { ArrowLeft } from "lucide-astro";
---

<RootLayout
  title="Página não encontrada — Ideilson"
  description="A página que você procura não foi encontrada."
>
  <main class="min-h-screen bg-[var(--canvas)] flex flex-col justify-between">
    <header class="border-b border-white/10">
      <div
        class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 md:px-12"
      >
        <a href="/" class="flex items-center gap-3 font-semibold text-white">
          <span
            class="grid h-8 w-8 place-items-center rounded-lg border border-emerald-300/40 bg-emerald-300/10 font-mono text-xs text-emerald-300"
          >
            ID
          </span>
          Ideilson
        </a>
      </div>
    </header>

    <section
      class="mx-auto max-w-7xl px-6 py-24 text-center md:px-12 flex flex-col items-center justify-center my-auto"
    >
      <p class="eyebrow">Erro 404</p>
      <h1
        class="mt-4 text-4xl font-semibold tracking-[-.055em] text-white sm:text-6xl"
      >
        Página não encontrada
      </h1>
      <p class="mt-6 max-w-md text-lg leading-8 text-[var(--muted)]">
        O link que você seguiu pode ter mudado ou a página não está mais disponível.
      </p>
      <div class="mt-10">
        <a
          href="/"
          class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-emerald-300 px-6 font-semibold text-slate-950 transition hover:bg-emerald-200"
        >
          <ArrowLeft class="w-4 h-4" aria-hidden="true" />
          Voltar ao início
        </a>
      </div>
    </section>

    <footer class="border-t border-white/10">
      <div
        class="mx-auto flex max-w-7xl flex-col gap-2 px-6 py-8 text-sm text-[var(--faint)] md:flex-row md:justify-between md:px-12"
      >
        <p>© {new Date().getFullYear()} Ideilson. Todos os direitos reservados.</p>
        <a
          class="hover:text-white transition"
          href="https://github.com/ideilsondev"
          target="_blank"
          rel="noreferrer"
        >
          github.com/ideilsondev
        </a>
      </div>
    </footer>
  </main>
</RootLayout>
