---
import RootLayout from "../layouts/RootLayout.astro";
import { ArrowLeft } from "lucide-astro";
---

<RootLayout
  title="Página não encontrada — Ideilson"
  description="A página que você procura não foi encontrada."
>
  <main class="min-h-screen bg-[var(--canvas)] flex flex-col justify-between">
    <header class="border-b border-[#d7e1ea] bg-white/90 backdrop-blur">
      <div
        class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 md:px-12"
      >
        <a href="/" class="flex items-center gap-3 font-semibold text-[#142638]">
          <span
            class="grid h-8 w-8 place-items-center rounded-lg border border-[var(--coastal)]/40 bg-[var(--coastal)]/10 font-mono text-xs font-bold text-[var(--coastal)]"
          >
            ID
          </span>
          <span class="tracking-tight text-lg">Ideilson</span>
        </a>
      </div>
    </header>

    <section
      class="mx-auto max-w-7xl px-6 py-24 text-center md:px-12 flex flex-col items-center justify-center my-auto"
    >
      <p class="eyebrow">Erro 404</p>
      <h1
        class="mt-4 text-4xl font-semibold tracking-[-.055em] text-[#142638] sm:text-6xl"
      >
        Página não encontrada
      </h1>
      <p class="mt-6 max-w-md text-lg leading-8 text-[#607486]">
        O link que você seguiu pode ter mudado ou a página não está mais disponível.
      </p>
      <div class="mt-10">
        <a
          href="/"
          class="btn-lava inline-flex min-h-12 items-center justify-center gap-2 rounded-full px-7 text-sm font-semibold transition"
        >
          <ArrowLeft class="w-4 h-4" aria-hidden="true" />
          Voltar ao início
        </a>
      </div>
    </section>

    <footer class="border-t border-[#d7e1ea] bg-white">
      <div
        class="mx-auto flex max-w-7xl flex-col gap-2 px-6 py-8 text-sm text-[#607486] md:flex-row md:justify-between md:px-12"
      >
        <p>© {new Date().getFullYear()} Ideilson. Todos os direitos reservados.</p>
        <a
          class="hover:text-[#142638] font-medium transition"
          href="https://github.com/ideilsonsouza"
          target="_blank"
          rel="noreferrer"
        >
          github.com/ideilsonsouza
        </a>
      </div>
    </footer>
  </main>
</RootLayout>
